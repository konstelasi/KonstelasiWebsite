# Apache rules for the static site on the cPanel host. Astro copies this file
# into dist/ unchanged.

# www.konstelasi.co.id is the same site, so it sends visitors to the address
# without www, keeping the path and query string. Cloudflare already moves
# http to https, so the target is always https.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.konstelasi\.co\.id$ [NC]
  RewriteRule ^ https://konstelasi.co.id%{REQUEST_URI} [R=301,L]
</IfModule>

# Missing pages get the 404 page in the visitor's language.
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/id/#">
  ErrorDocument 404 /id/404/index.html
</If>

# Old WordPress URLs that moved. Each rule covers the English path and its
# Indonesian twin under /id/. Most pages kept their URL and need no rule.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/(id/)?project/star-dust/?$ /$1software/stardust/
  RedirectMatch 301 ^/(id/)?project/star-core/?$ /$1software/starcore/
  RedirectMatch 301 ^/(id/)?project/hyper-cms/?$ /$1software/hyper-cms/
  RedirectMatch 301 ^/(id/)?project/routemate/?$ /$1software/routemate/
  RedirectMatch 301 ^/(id/)?projects/?$ /$1labs/
  RedirectMatch 301 ^/(id/)?development-status/[^/]+/?$ /$1labs/

  # WordPress put the date in a post's URL. The slugs stayed the same.
  RedirectMatch 301 ^/(id/)?2025/12/24/stars-align-starcore-reaches-stability-with-v0-2-0/?$ /$1blog/stars-align-starcore-reaches-stability-with-v0-2-0/
  RedirectMatch 301 ^/(id/)?2026/04/07/stardust-v0-3-0-scaling-codeigniter-4-with-vertical-schema-partitioning/?$ /$1blog/stardust-v0-3-0-scaling-codeigniter-4-with-vertical-schema-partitioning/
  RedirectMatch 301 ^/(id/)?category/blog/?$ /$1blog/

  # Feed readers subscribed to the WordPress feeds get the new one.
  RedirectMatch 301 ^/(id/)?(category/blog/)?feed/?$ /$1blog/rss.xml
</IfModule>

# Files under /_astro/ carry a content hash in their name, so they never
# change and can be cached for a year. Pages are always revalidated.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#(/|\.html)$#">
    Header set Cache-Control "no-cache"
  </If>
</IfModule>
