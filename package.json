{
  "name": "konstelasi-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The konstelasi.co.id company site, built as static files with Astro.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify:contrast": "node --experimental-strip-types --no-warnings scripts/verify-contrast.ts",
    "verify:copy": "node --experimental-strip-types --no-warnings scripts/verify-copy.ts",
    "verify:links": "node --experimental-strip-types --no-warnings scripts/verify-links.ts",
    "deploy": "bash deploy.sh",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/poppins": "5.3.0",
    "astro": "7.3.6",
    "astro-icon": "1.2.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "ogl": "1.0.11"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@iconify-json/lucide": "1.2.140",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "satori": "0.35.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
