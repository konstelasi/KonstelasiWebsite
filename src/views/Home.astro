---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Constellation from '../components/home/Constellation.astro';
import ServiceSystem from '../components/home/ServiceSystem.astro';
import SlotDemo from '../components/home/SlotDemo.astro';
import ProductOrbit from '../components/home/ProductOrbit.astro';
import { NODES, GROUND } from '../components/home/system-shape';
import Status from '../components/Status.astro';
import { type Lang, ui, localePath } from '../i18n';
import { ordered, slugOf } from '../lib/content';
import { staticPages } from '../lib/pages';
import { contact } from '../lib/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const meta = staticPages['/'][lang];

const services = await ordered('services', lang);
const products = await ordered('products', lang);
const stardust = products.find((p) => slugOf(p) === 'stardust');
if (!stardust) throw new Error('the home page needs the stardust product entry');

const copy = {
  en: {
    statement: 'Software and AI, crafted to fit the way you work.',
    lede: "Konstelasi is a software company in Yogyakarta. We build custom apps, automate the busywork between your tools, and set up AI that answers from your own data. The work is reliable, and the price makes sense.",
    opening: "Tell us what you're building",
    systemTitle: 'Everything we do connects',
    systemLede: 'Most projects start with one of these and grow into the next. Open one to see what it covers.',
    labTitle: 'Made in our lab',
    labLede: 'Open-source software we design ourselves, use in client work and maintain in public.',
    spotlightTitle: 'A closer look at StarDust',
    spotlightLede: 'One product from the lab, shown at work.',
    demoLabel: 'An animation of a StarDust write. The value "software" is copied from the JSON payload into the indexed slot column i_str_01, the value 120 into i_num_01, and the new row is marked as indexed.',
    indexed: 'indexed',
    stardustMore: 'How StarDust works',
    workTitle: 'How we work',
    work: [
      {
        text: 'We start by listening. Before anyone writes code, we sit with the people who will use the software and learn how the work really gets done, including the workarounds nobody wrote down.',
        note: "Discovery comes first. It is where most of a project's risk gets removed.",
      },
      {
        text: 'Then we design the data and the flow of the system, because a schema is far cheaper to change on paper than in production.',
        note: 'Architecture before code.',
      },
      {
        text: "We build in short sprints and show you working software along the way, so you can steer while steering is still easy. Deadlines matter to us. Getting it right matters more, and we plan so that we rarely have to choose.",
        note: 'Regular demos, and no surprises at the end.',
      },
      {
        text: "When it ships, we set up and harden the servers and hand over the complete source code. It is your software. If you'd like us to stay and look after it, we will, and if not, your team has everything it needs.",
        note: 'Full source handover, then support for as long as you want it.',
      },
    ],
    closing: 'Show us what you have in mind, and we will help you make it real.',
    whatsapp: 'WhatsApp',
    contactPage: 'All contact details',
  },
  id: {
    statement: 'Software dan AI yang dirancang mengikuti cara Anda bekerja.',
    lede: 'Konstelasi adalah perusahaan software di Yogyakarta. Kami membangun aplikasi custom, mengotomatiskan pekerjaan berulang di antara alat-alat Anda, dan memasang AI yang menjawab dari data Anda sendiri. Hasilnya andal, dengan harga yang masuk akal.',
    opening: 'Ceritakan apa yang sedang Anda bangun',
    systemTitle: 'Semua yang kami kerjakan saling terhubung',
    systemLede: 'Kebanyakan proyek dimulai dari salah satunya, lalu berkembang ke yang berikutnya. Buka salah satu untuk melihat cakupannya.',
    labTitle: 'Dibuat di lab kami',
    labLede: 'Software open source yang kami rancang sendiri, kami pakai di proyek klien, dan kami rawat secara terbuka.',
    spotlightTitle: 'Lebih dekat dengan StarDust',
    spotlightLede: 'Satu produk dari lab kami, saat sedang bekerja.',
    demoLabel: 'Animasi proses tulis di StarDust. Nilai "software" disalin dari payload JSON ke kolom slot ber-index i_str_01, nilai 120 ke i_num_01, lalu baris barunya ditandai sudah ter-index.',
    indexed: 'ter-index',
    stardustMore: 'Cara kerja StarDust',
    workTitle: 'Cara kami bekerja',
    work: [
      {
        text: 'Kami mulai dengan mendengarkan. Sebelum ada kode yang ditulis, kami duduk bersama orang-orang yang akan memakai software-nya dan mempelajari bagaimana pekerjaan itu benar-benar berjalan, termasuk jalan pintas yang tidak pernah dicatat siapa pun.',
        note: 'Discovery selalu didahulukan. Di tahap inilah sebagian besar risiko proyek bisa dihilangkan.',
      },
      {
        text: 'Setelah itu kami merancang data dan alur sistemnya, karena mengubah skema di atas kertas jauh lebih murah daripada di production.',
        note: 'Arsitektur dulu, baru kode.',
      },
      {
        text: 'Kami membangun dalam sprint pendek dan menunjukkan software yang sudah bisa dipakai di sepanjang jalan, supaya Anda bisa mengarahkan selagi masih mudah diarahkan. Tenggat waktu penting bagi kami. Hasil yang benar lebih penting lagi, dan kami merencanakan semuanya agar jarang harus memilih salah satu.',
        note: 'Demo berkala, tanpa kejutan di akhir.',
      },
      {
        text: 'Saat software-nya siap dipakai, kami menyiapkan dan mengamankan server, lalu menyerahkan seluruh source code. Software itu milik Anda. Kalau Anda ingin kami tetap merawatnya, kami siap. Kalau tidak, tim Anda sudah memegang semua yang dibutuhkan.',
        note: 'Source code diserahkan utuh, dukungan tersedia selama Anda butuhkan.',
      },
    ],
    closing: 'Tunjukkan apa yang ada di pikiran Anda, dan kami bantu mewujudkannya.',
    whatsapp: 'WhatsApp',
    contactPage: 'Semua kontak',
  },
}[lang];

const constellationLabels = services.map((s) => s.data.name) as [string, string, string, string];
---

<Base lang={lang} title={meta.title} description={meta.description} bare>
  <section class="opening">
    <div class="opening-text">
      <h1 data-split="lines">{copy.statement}</h1>
      <p class="lede">{copy.lede}</p>
      <a class="go" href={localePath(lang, '/contact-us/')}>
        {copy.opening}
        <Icon name="lucide:arrow-right" aria-hidden="true" />
      </a>
    </div>
    <div class="opening-sky">
      <Constellation labels={constellationLabels} />
    </div>
  </section>

  <section class="what" aria-labelledby="what-title">
    <header class="what-head">
      <h2 id="what-title" data-split="words">{copy.systemTitle}</h2>
      <p>{copy.systemLede}</p>
    </header>
    <ServiceSystem lang={lang} services={services} />
    <div class="what-sky" aria-hidden="true">
      <div class="what-map" data-map>
        {services.slice(0, 3).map((_, i) => (
          <span class="node" data-node={i} style={`--x:${NODES[i][0] * 100}%;--y:${NODES[i][1] * 100}%`}>{i + 1}</span>
        ))}
        {services.slice(0, 3).map((sv, i) => (
          <span class="tag" data-tag={i} style={`--x:${(NODES[i][0] + 0.025) * 100}%;--y:${(GROUND - 0.15) * 100}%`}>{sv.data.name}</span>
        ))}
        <span class="tag ground" data-tag="3" style={`--x:50%;--y:${(GROUND + 0.075) * 100}%`}>{services[3].data.name}</span>
      </div>
    </div>
  </section>

  <section class="lab" aria-labelledby="lab-title">
    <div class="lab-head reveal">
      <h2 id="lab-title" data-split="chars">{copy.labTitle}</h2>
      <p>{copy.labLede}</p>
    </div>

    <div class="orbit-wrap reveal">
      <ProductOrbit lang={lang} products={products} />
      <a class="go" href={localePath(lang, '/labs/')}>
        {t.common.allProducts}
        <Icon name="lucide:arrow-right" aria-hidden="true" />
      </a>
    </div>

  </section>

  <section class="spotlight" aria-labelledby="spotlight-title">
    <div class="spotlight-inner">
      <header class="spotlight-head reveal">
        <h2 id="spotlight-title">{copy.spotlightTitle}</h2>
        <p>{copy.spotlightLede}</p>
      </header>
      <article class="stardust reveal">
        <div class="sd-text">
          <div class="sd-meta">
            <h3 style="view-transition-name: product-stardust"><a href={localePath(lang, '/software/stardust/')}>{stardust.data.name}</a></h3>
            <span class="mono version">v{stardust.data.version}</span>
            <Status lang={lang} status={stardust.data.status} />
          </div>
          <p class="sd-summary">{stardust.data.summary}</p>
          <a class="go" href={localePath(lang, '/software/stardust/')}>
            {copy.stardustMore}
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
        </div>
        <SlotDemo label={copy.demoLabel} indexed={copy.indexed} />
      </article>
    </div>
  </section>

  <section class="work" aria-labelledby="work-title">
    <h2 id="work-title" class="reveal">{copy.workTitle}</h2>
    <div class="essay">
      {copy.work.map((w) => (
        <div class="beat reveal">
          <p data-split="lines">{w.text}</p>
          <aside>{w.note}</aside>
        </div>
      ))}
    </div>
  </section>

  <section class="band" aria-label={t.nav.contact}>
    <div class="aurora" aria-hidden="true"></div>
    <div class="band-inner reveal">
      <p class="band-line" data-split="words">{copy.closing}</p>
      <div class="band-contact">
        <svg class="band-send" viewBox="0 0 140 96" aria-hidden="true" data-send>
          <path class="send-route" d="M10 14 L70 56 L130 14 L130 82 L10 82 Z" />
          <path class="send-body" d="M10 14 H130 V82 H10 Z" />
          <path class="send-flap" d="M10 14 L70 56 L130 14" />
          <circle class="send-star" cx="10" cy="14" r="3.4" />
          <circle class="send-star" cx="130" cy="14" r="3.4" />
          <circle class="send-star" cx="130" cy="82" r="3.4" />
          <circle class="send-star" cx="10" cy="82" r="3.4" />
          <circle class="send-star" cx="70" cy="56" r="3.4" />
          <circle class="send-packet" r="4.5" />
        </svg>
        <a class="band-mail" href={`mailto:${contact.email}`}>{contact.email}</a>
        <p>
          <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
          <span aria-hidden="true">/</span>
          <a href={contact.whatsappHref} rel="noopener">{copy.whatsapp}</a>
        </p>
        <a class="band-more" href={localePath(lang, '/contact-us/')}>{copy.contactPage}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  section {
    padding-inline: var(--gutter);
  }
  .work { padding-top: clamp(4rem, 10vh, 7rem); }

  /* Opening. A left-aligned statement in very large type, with the
     constellation bleeding off the right edge. */
  .opening {
    position: relative;
    max-width: var(--w-wide);
    margin: 0 auto;
    padding-top: clamp(3rem, 9vh, 7rem);
    padding-bottom: clamp(4rem, 12vh, 9rem);
  }
  .opening-text {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  h1 {
    font-size: clamp(2.6rem, 5.9vw, 4.9rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .lede {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--text-dim);
  }
  .opening-sky {
    position: absolute;
    top: 0;
    right: calc(-1 * var(--gutter) - 12vw);
    width: min(52vw, 46rem);
    pointer-events: none;
  }

  /* With the star field running, the mark is drawn in stars instead, so the
     SVG constellation steps aside. */
  :global(.webgl) .opening-sky {
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  @media (min-width: 62rem) {
    .opening {
      min-height: calc(100svh - 4.5rem);
      display: flex;
      align-items: center;
    }
    /* The star mark takes the right half (home-motion.ts), so the text
       keeps to the left half instead of running over it. */
    .opening-text { max-width: min(42rem, 52%); }
  }

  @media (max-width: 62rem) {
    .opening-sky {
      position: relative;
      right: auto;
      width: 115%;
      margin: 2.5rem -15% 0 0;
    }
    .opening-sky :global(text) { display: none; }
    .opening { padding-bottom: 3rem; }
  }

  /* What we do. Heading and lede side by side, the diagram full width. */
  .what {
    max-width: var(--w-wide);
    margin: 0 auto;
    padding-block: 2rem clamp(5rem, 12vh, 8rem);
  }
  .what-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    align-items: end;
    gap: 1.5rem 4rem;
    margin-bottom: 2.75rem;
  }
  .what-head h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    max-width: 18ch;
  }
  .what-head p { color: var(--text-dim); }

  /* The pinned sequence (src/components/home/home-motion.ts sets
     data-mode). The stages stack on the left and open one by one, and the
     stars draw the system on the right. */
  .what-sky { display: none; position: relative; }
  /* Labels over the stars, so the shape they draw reads as the system it
     is. home-motion.ts sizes the map to the fitted shape every frame. */
  .what-map {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .what-map .node,
  .what-map .tag {
    position: absolute;
    left: var(--x);
    top: var(--y);
    color: var(--text-faint);
    transition: color 0.3s var(--ease);
  }
  .what-map .node {
    translate: -50% -50%;
    font: 500 0.85rem/1 var(--mono);
  }
  .what-map .tag {
    width: 21%;
    font-size: 0.82rem;
    line-height: 1.25;
  }
  .what-map .tag.ground {
    width: auto;
    translate: -50% 0;
    white-space: nowrap;
  }
  .what-map .on { color: var(--text); }
  .what-map .node.on { color: var(--brand); }
  .what[data-mode='sequence'] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(2rem, 5vw, 5rem);
    align-content: center;
    min-height: 100svh;
    padding-block: 4.5rem 2rem;
  }
  .what[data-mode='sequence'] .what-head {
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 1.25rem;
  }
  /* The pinned screen can't scroll, so everything in it has to fit. On
     windows under about 930px tall the lede steps aside and the title
     shrinks, which leaves room for the open stage and the base layer. */
  @media (max-height: 58rem) {
    .what[data-mode='sequence'] .what-head p { display: none; }
    .what[data-mode='sequence'] .what-head h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  }
  .what[data-mode='sequence'] .what-sky {
    display: block;
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    height: min(72svh, 38rem);
  }

  /* Products. The orbit of all four, then StarDust in a wide panel. */
  .lab {
    max-width: var(--w-wide);
    margin: 0 auto;
    display: grid;
    gap: clamp(2.5rem, 6vh, 4rem);
    padding-bottom: clamp(4rem, 9vh, 6rem);
  }
  .orbit-wrap {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .lab-head {
    grid-column: 1 / -1;
    max-width: 36rem;
    display: grid;
    gap: 0.75rem;
  }
  .lab-head h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .lab-head p { color: var(--text-dim); }

  /* StarDust gets its own band, so it reads as a closer look at one product
     rather than a fifth item in the list above it. */
  .spotlight {
    padding-inline: 0;
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }
  .spotlight-inner {
    max-width: var(--w-wide);
    margin: 0 auto;
    padding: clamp(3rem, 8vh, 5rem) var(--gutter);
    display: grid;
    gap: 2rem;
  }
  .spotlight-head {
    display: grid;
    gap: 0.5rem;
    max-width: 36rem;
  }
  .spotlight-head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .spotlight-head p { color: var(--text-dim); }

  .stardust {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 1.5rem clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .sd-text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .sd-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  .sd-meta h3 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 500;
  }
  .sd-meta h3 a { text-decoration: none; }
  .sd-meta h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .version {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .sd-summary {
    max-width: 34rem;
    color: var(--text-dim);
  }

  @media (max-width: 58rem) {
    .stardust { grid-template-columns: minmax(0, 1fr); }
    .what-head { grid-template-columns: minmax(0, 1fr); }
  }

  /* How we work. One narrow column of large text, with notes in the
     margin like an essay. */
  .work {
    max-width: 66rem;
    margin: 0 auto;
    padding-bottom: clamp(5rem, 14vh, 10rem);
  }
  .work h2 {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-faint);
    margin-bottom: 2rem;
  }
  .essay {
    position: relative;
    display: grid;
    gap: 2rem;
  }
  /* The comet path from src/components/home/comet.ts. */
  .essay :global(.comet-sky) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .essay :global(.comet-rail) {
    fill: none;
    stroke: var(--border-bright);
    stroke-width: 1;
  }
  .essay :global(.comet-link) {
    fill: none;
    stroke: var(--border-bright);
    stroke-width: 1;
  }
  .essay :global(.comet-stop) {
    fill: var(--bg);
    stroke: var(--border-hover);
    stroke-width: 1.25;
  }
  .essay :global(.comet-trail) {
    fill: none;
    stroke: var(--brand);
    stroke-width: 1.5;
  }
  .essay :global(.comet-head) { fill: var(--brand); }
  .essay :global(.comet-halo) {
    fill: var(--brand-soft);
    stroke: var(--brand);
    stroke-opacity: 0.35;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .essay :global(.moving .comet-halo) { opacity: 1; }
  .beat {
    display: grid;
    grid-template-columns: minmax(0, 42rem) minmax(0, 15rem);
    gap: 1rem 3.5rem;
    align-items: start;
  }
  .beat p {
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
    line-height: 1.5;
    letter-spacing: -0.012em;
  }
  /* The margin note as a speech bubble, its tail pointing back at the rail.
     The text sits in the middle of the bubble, and the rail's stop is level
     with that middle (comet.ts). */
  .beat aside {
    position: relative;
    align-self: start;
    display: flex;
    align-items: center;
    min-height: 3.1rem;
    padding: 0.7rem 1.05rem;
    background: var(--bg-raised);
    border: 1px solid var(--border-bright);
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-faint);
    transition: color 0.5s var(--ease), border-color 0.5s var(--ease);
  }
  .beat aside::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 50%;
    width: 10px;
    height: 10px;
    background: var(--bg-raised);
    border-left: 1px solid;
    border-bottom: 1px solid;
    border-color: inherit;
    border-top-color: transparent;
    border-right-color: transparent;
    translate: 0 -50%;
    rotate: 45deg;
  }
  .beat aside:global(.lit) {
    color: var(--text-dim);
    border-color: var(--brand);
  }
  @media (max-width: 52rem) {
    .beat { grid-template-columns: minmax(0, 1fr); }
    /* Under the paragraph, the tail points up at it. */
    .beat aside { margin-top: 0.4rem; justify-self: start; }
    .beat aside::before {
      left: 1.2rem;
      top: -6px;
      translate: 0 0;
      border-left-color: inherit;
      border-top-color: inherit;
      border-bottom-color: transparent;
    }
  }

  /* Closing. The one full-bleed violet band on the page. */
  .band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--brand-fill);
    color: var(--on-brand-fill);
  }
  /* The aurora: two soft lights in deeper and brighter violet drifting
     slowly across the band. Reduced motion leaves them still. */
  .aurora {
    position: absolute;
    inset: -40%;
    z-index: -1;
    background:
      radial-gradient(38% 46% at 30% 40%, var(--brand-fill-2), transparent 70%),
      radial-gradient(34% 40% at 72% 62%, var(--brand-fill-3), transparent 72%),
      radial-gradient(26% 30% at 55% 30%, var(--brand-fill-2), transparent 70%);
    filter: blur(20px);
    animation: aurora 22s ease-in-out infinite alternate;
  }
  @keyframes aurora {
    0% { transform: translate(-6%, -3%) rotate(0deg) scale(1); }
    50% { transform: translate(5%, 4%) rotate(8deg) scale(1.08); }
    100% { transform: translate(-2%, 6%) rotate(-6deg) scale(1.02); }
  }
  /* An envelope drawn as a small constellation, above the email address. A
     star keeps travelling around it (band-motion.ts), the way a message
     goes out. */
  .band-send {
    width: 8.5rem;
    height: auto;
    margin-bottom: 0.75rem;
    overflow: visible;
  }
  .send-route { fill: none; stroke: none; }
  .send-body,
  .send-flap {
    fill: none;
    stroke: var(--on-brand-dim);
    stroke-width: 1;
    stroke-linejoin: round;
    opacity: 0.6;
  }
  .send-star { fill: var(--on-brand-dim); }
