---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { type Lang, formatDate } from '../i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'legal'>;
}

const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const updated = { en: 'Last updated', id: 'Terakhir diperbarui' }[lang];
---

<Base lang={lang} title={entry.data.title} description={entry.data.description}>
  <article>
    <header>
      <h1>{entry.data.title}</h1>
      <p>{updated} <time datetime={entry.data.updated.toISOString().slice(0, 10)}>{formatDate(lang, entry.data.updated)}</time></p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  article {
    max-width: var(--w-narrow);
    margin: 0 auto;
    padding: clamp(3rem, 9vh, 6rem) var(--gutter) 2rem;
    box-sizing: content-box;
  }
  header {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  header p {
    font-size: 0.9rem;
    color: var(--text-faint);
  }
</style>
