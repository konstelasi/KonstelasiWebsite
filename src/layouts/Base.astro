---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/tokens.css';
import '../styles/base.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, ui, htmlLang, ogLocale, localePath, basePath, langs, otherLang } from '../i18n';
import { ogImagePath } from '../lib/og';

interface Props {
  lang: Lang;
  /** The page's own title. The site name is appended unless `bare` is set. */
  title: string;
  description?: string;
  bare?: boolean;
  noindex?: boolean;
  /** Set for article pages, so link previews describe them as articles. */
  article?: { published: Date; tags?: string[] };
  /** `quiet` dims the star field behind long reading, such as the policy. */
  sky?: 'full' | 'quiet';
}

const { lang, title, description, bare = false, noindex = false, article, sky = 'full' } = Astro.props;
const t = ui(lang);
const site = Astro.site ?? new URL('https://konstelasi.co.id');
const path = basePath(Astro.url.pathname);

const fullTitle = bare ? title : `${title} | ${t.site.name}`;
const desc = description ?? t.site.description;
const canonical = new URL(localePath(lang, path), site).href;
// The 404 page has no preview of its own, so it borrows the home page's.
const og = new URL(ogImagePath(lang, noindex ? '/' : path), site).href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before first paint, so a stored theme never flashes the other one.
      // `motion` lets CSS hide what the motion modules are about to animate
      // in. If they haven't reported ready within 3 s (blocked, failed, very
      // slow), the class goes again and the page shows everything as is.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          setTimeout(function () {
            if (!root.classList.contains('motion-ready')) root.classList.remove('motion');
          }, 3000);
        }
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') root.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && langs.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath(l, path), site).href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(path, site).href} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f6f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090909" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.tags?.map((name) => <meta property="article:tag" content={name} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Blog | ${t.site.name}`} href={localePath(lang, '/blog/rss.xml')} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-sky={sky}>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/reveal';
      import '../motion/index';
    </script>
  </body>
</html>
