---
import Mark from '../assets/konstelasi-logo.svg';

interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<!-- Inline SVG in currentColor, so it follows the theme on its own. It's
     decorative wherever it sits next to the company name. -->
<Mark width={size} height={size} aria-hidden="true" class:list={['logo', className]} />

<style>
  .logo { flex: none; }
</style>
