---
import { Image } from 'astro:assets';
import logo from '../assets/konstelasi-logo-black.png';

interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<!-- The mark is a black PNG, so dark mode inverts it through --logo-filter.
     It's decorative wherever it sits next to the company name. -->
<Image
  src={logo}
  alt=""
  width={size}
  height={size}
  densities={[1, 2]}
  class:list={['logo', className]}
  loading="eager"
/>

<style>
  .logo {
    filter: var(--logo-filter);
    flex: none;
  }
</style>
