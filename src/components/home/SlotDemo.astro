---
/**
 * What StarDust does on a write. Two values leave the JSON payload and
 * settle into the indexed slot columns of a new row, then the row is marked
 * indexed. With the motion modules the scroll drives it. Without them, a slow
 * CSS loop plays it instead.
 *
 * Drawn in SVG user units, so the chips can travel between fixed points.
 * Values in the payload sit in an aligned column at x = 196 for the same
 * reason. With reduced motion, the drawing shows the finished state.
 */
interface Props {
  label: string;
  indexed: string;
}

const { label, indexed } = Astro.props;

const rowY = [96, 130, 164];
---

<svg class="demo" viewBox="0 0 660 250" role="img" aria-label={label} data-draw>
  <g class="caption">
    <text x="20" y="22">entry_data.payload</text>
    <text x="372" y="22">entry_slots_page_1</text>
  </g>

  <rect class="card" x="8" y="36" width="318" height="176" rx="8" />
  <g class="json">
    <text x="24" y="70">{'{'}</text>
    <text x="40" y="100">"name":</text>
    <text x="196" y="100" class="val">"Arunika",</text>
    <text x="40" y="130">"industry":</text>
    <text x="196" y="130" class="val">"software",</text>
    <text x="40" y="160">"employees":</text>
    <text x="196" y="160" class="val">120</text>
    <text x="24" y="190">{'}'}</text>
  </g>

  <rect class="card" x="356" y="36" width="296" height="176" rx="8" />
  <g class="grid">
    <text x="372" y="66" class="head">i_str_01</text>
    <text x="520" y="66" class="head">i_num_01</text>
    <line x1="366" y1="76" x2="642" y2="76" />
    <text x="372" y={rowY[0]} class="old">"retail"</text>
    <text x="520" y={rowY[0]} class="old">45</text>
    <text x="372" y={rowY[1]} class="old">"logistics"</text>
    <text x="520" y={rowY[1]} class="old">310</text>
    <rect class="slot" x="364" y={rowY[2] - 19} width="140" height="28" rx="5" />
    <rect class="slot" x="512" y={rowY[2] - 19} width="80" height="28" rx="5" />
  </g>

  <g class="mark">
    <circle cx="622" cy={rowY[2] - 5} r="9" />
    <path d={`M617 ${rowY[2] - 5} l3.5 3.5 l6 -7`} />
    <text x="652" y={rowY[2] + 30} text-anchor="end">{indexed}</text>
  </g>

  <g class="mover mover-a">
    <g class="chip chip-a">
      <rect x="188" y="111" width="116" height="27" rx="5" />
      <text x="196" y="130">"software"</text>
    </g>
  </g>
  <g class="mover mover-b">
    <g class="chip chip-b">
      <rect x="188" y="141" width="44" height="27" rx="5" />
      <text x="196" y="160">120</text>
    </g>
  </g>
</svg>

<script>
  // The two values travel into their slots as the demo scrolls through the
  // view, and the row is marked indexed once both have landed. Scrolling back
  // plays it in reverse, so the reader controls the pace.
  import { gsap, motionOn } from '../../motion/core';

  if (motionOn) {
    document.querySelectorAll<SVGSVGElement>('svg.demo').forEach((svg) => {
      // The wrappers carry the scroll-driven move. The chips inside keep the
      // CSS translate of the no-JS loop, and GSAP must never share an element
      // with it: it writes an inline CSS transform that hides its own move.
      const a = svg.querySelector('.mover-a');
      const b = svg.querySelector('.mover-b');
      const mark = svg.querySelector('.mark');
      if (!a || !b || !mark) return;
      gsap
        .timeline({ scrollTrigger: { trigger: svg, start: 'top 82%', end: 'bottom 30%', scrub: 0.6 } })
        .fromTo(a, { opacity: 0, x: 0, y: 0 }, { opacity: 1, duration: 0.12 })
        .to(a, { x: 176, y: 34, duration: 0.4, ease: 'power2.inOut' })
        .fromTo(b, { opacity: 0, x: 0, y: 0 }, { opacity: 1, duration: 0.12 }, '-=0.25')
        .to(b, { x: 324, y: 4, duration: 0.4, ease: 'power2.inOut' })
        .fromTo(mark, { opacity: 0, scale: 0.4, svgOrigin: '622 159' }, { opacity: 1, scale: 1, duration: 0.2, ease: 'back.out(2)' })
        .to({}, { duration: 0.15 });
    });
  }
</script>

<style>
  .demo {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--mono);
  }

  .caption text {
    font-size: 12px;
    fill: var(--text-faint);
  }

  .card {
    fill: var(--bg);
    stroke: var(--border-bright);
  }

  .json text,
  .grid text,
  .chip text {
    font-size: 15px;
  }
  .json text { fill: var(--text-dim); }
  .json .val { fill: var(--text); }
  .grid .head { fill: var(--text-faint); font-size: 13px; }
  .grid .old { fill: var(--text-dim); }
  .grid line { stroke: var(--border); }
  .slot {
    fill: none;
    stroke: var(--border-hover);
    stroke-dasharray: 3 3;
  }

  .chip rect {
    fill: var(--brand-soft);
    stroke: var(--brand);
  }
  .chip text { fill: var(--text); }

  .mark circle { fill: var(--brand); }
  .mark path {
    fill: none;
    stroke: var(--bg);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark text {
    font-size: 12px;
    fill: var(--brand);
  }

  /* The chips travel from the payload to their slot. The offsets are the
     distance between the two positions in user units. */
  .chip-a { --to: 176px 34px; }
  .chip-b { --to: 324px 4px; }

  /* Reduced motion, no JS, or before the drawing is on screen: the finished
     state, with both values in place and the row marked. */
  .chip { translate: var(--to); }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .demo .chip { translate: 0 0; opacity: 0; }
    :global(.js) .demo .mark { opacity: 0; }
    :global(.js) .demo.is-in .chip-a { animation: travel 11s var(--ease) infinite; }
    :global(.js) .demo.is-in .chip-b { animation: travel 11s var(--ease) 1.1s infinite; }
    :global(.js) .demo.is-in .mark { animation: mark 11s var(--ease) 1.1s infinite; }
  }

  /* Once the motion modules are in, the scroll drives the chips instead of
     the loop (see the script above). */
  :global(.motion-ready) .demo .chip,
  :global(.motion-ready) .demo .mark { animation: none !important; }
  :global(.motion-ready) .demo .chip { translate: none; opacity: 1; }

  @keyframes travel {
    0%   { opacity: 0; translate: 0 0; }
    8%   { opacity: 1; translate: 0 0; }
    15%  { opacity: 1; translate: 0 0; }
    32%  { opacity: 1; translate: var(--to); }
    82%  { opacity: 1; translate: var(--to); }
    92%  { opacity: 0; translate: var(--to); }
    100% { opacity: 0; translate: var(--to); }
  }

  @keyframes mark {
    0%, 34% { opacity: 0; }
    40%, 80% { opacity: 1; }
    90%, 100% { opacity: 0; }
  }
</style>
