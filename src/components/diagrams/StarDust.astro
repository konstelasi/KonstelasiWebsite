---
import Figure from './Figure.astro';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const l = {
  en: {
    payloadNote: 'the full record, always',
    slotNote: 'typed and indexed',
    mirror: 'mirrored',
    caption: 'Every entry keeps its complete JSON payload. Fields marked filterable are mirrored, one row per entry, into typed slot columns that carry a real index.',
    label: 'Two tables. entry_data holds each entry with its full JSON payload. entry_slots_page_1 holds the same entries, one row each, with the industry value in column i_str_01 and the employees value in i_num_01.',
  },
  id: {
    payloadNote: 'record lengkap, selalu',
    slotNote: 'bertipe dan ber-index',
    mirror: 'disalin',
    caption: 'Setiap entry menyimpan payload JSON lengkapnya. Field yang ditandai filterable disalin, satu baris per entry, ke kolom slot bertipe yang memiliki index sungguhan.',
    label: 'Dua tabel. entry_data menyimpan setiap entry beserta payload JSON lengkapnya. entry_slots_page_1 menyimpan entry yang sama, satu baris per entry, dengan nilai industry di kolom i_str_01 dan nilai employees di i_num_01.',
  },
}[lang];

const rows = [
  { id: 41, json: '{"industry":"software",…}', s: '"software"', n: '120' },
  { id: 42, json: '{"industry":"retail",…}', s: '"retail"', n: '45' },
  { id: 43, json: '{"industry":"logistics",…}', s: '"logistics"', n: '310' },
];
const y0 = 132;
const rh = 40;
---

<Figure caption={l.caption} label={l.label}>
  <svg viewBox="0 0 800 270" aria-hidden="true">
    <g data-step style="--step: 0">
      <text class="t" x="20" y="24">entry_data</text>
      <text class="t-faint" x="20" y="44">{l.payloadNote}</text>
      <rect class="box" x="20" y="60" width="410" height="190" rx="8" />
      <text class="t-faint" x="38" y="92">id</text>
      <text class="t-faint" x="88" y="92">tenant</text>
      <text class="t-faint" x="168" y="92">payload</text>
      <line class="grid" x1="20" y1="106" x2="430" y2="106" />
      {rows.map((r, i) => (
        <g>
          <text class="t-mono" x="38" y={y0 + i * rh}>{r.id}</text>
          <text class="t-mono" x="88" y={y0 + i * rh}>1</text>
          <text class="t-mono" x="168" y={y0 + i * rh}>{r.json}</text>
        </g>
      ))}
    </g>

    <g data-step style="--step: 2">
      <text class="t" x="510" y="24">entry_slots_page_1</text>
      <text class="t-faint" x="510" y="44">{l.slotNote}</text>
      <rect class="box" x="510" y="60" width="270" height="190" rx="8" />
      <text class="t-faint" x="528" y="86">id</text>
      <text class="t-faint" x="572" y="86">i_str_01</text>
      <text class="t-faint" x="690" y="86">i_num_01</text>
      <text class="t-key" x="572" y="101">industry</text>
      <text class="t-key" x="690" y="101">employees</text>
      <line class="grid" x1="510" y1="106" x2="780" y2="106" />
      {rows.map((r, i) => (
        <g>
          <text class="t-mono" x="528" y={y0 + i * rh}>{r.id}</text>
          <text class="t-mono" x="572" y={y0 + i * rh}>{r.s}</text>
          <text class="t-mono" x="690" y={y0 + i * rh}>{r.n}</text>
        </g>
      ))}
    </g>

    <g data-step style="--step: 1">
      {rows.map((_, i) => (
        <path class="line-key" d={`M430 ${y0 - 5 + i * rh} H510 M504 ${y0 - 9 + i * rh} L510 ${y0 - 5 + i * rh} L504 ${y0 - 1 + i * rh}`} />
      ))}
      <text class="t-key" x="468" y="240" text-anchor="middle">{l.mirror}</text>
    </g>
  </svg>
</Figure>
